{
    "version_count": 1,
    "segment_count": 6,
    "output_dir": "C:\\Users\\Administrator\\Desktop\\video-rewash-tool-main\\output_videos",
    "input_dir": "C:/Users/Administrator/Desktop/下载/downloads/新建文件夹",
    "last_used_preset": "标准-自定义",
    "switches": {
        "normalize": true,
        "quality_check": true
    },
    "normalize": {
        "aspect_ratio": "3:4",
        "width": 810,
        "height": 1080,
        "fps": 30,
        "pix_fmt": "yuv420p",
