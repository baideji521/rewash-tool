    "performance": {
        "workers": {
            "auto": true,
            "max": 4
        },
        "video_concurrency": 3,
        "nvenc_max_sessions": 3
    },
    "fingerprint": {
        "enable": true,
        "sample_frames": 10,
        "max_similarity": 0.7,
        "retry_max": 3
